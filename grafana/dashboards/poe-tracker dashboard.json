    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Currencies",
          "description": "Table of all currencies showing their value in the 3 most commonly used currencies",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "poe-postgres"
                      },
                      "spec": {
                        "dataset": "poe_tracker_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH current_league AS (\r\n    SELECT league_id\r\n    FROM poe_currency_history\r\n    WHERE game = '$game'\r\n      AND league_id = '$league'\r\n    ORDER BY fetched_at DESC\r\n    LIMIT 1\r\n),\r\n\r\nlatest_snapshot AS (\r\n    SELECT MAX(fetched_at) AS fetched_at\r\n    FROM poe_currency_history\r\n    WHERE game = '$game'\r\n      AND league_id = (SELECT league_id FROM current_league)\r\n),\r\n\r\nbaseline_snapshot AS (\r\n    SELECT MIN(fetched_at) AS fetched_at\r\n    FROM poe_currency_history\r\n    WHERE game = '$game'\r\n      AND league_id = (SELECT league_id FROM current_league)\r\n      AND fetched_at >= (\r\n        SELECT fetched_at\r\n        FROM latest_snapshot\r\n    ) - INTERVAL '7 days'\r\n),\r\n\r\nsnapshot AS (\r\n    SELECT currency_name, primary_value\r\n    FROM poe_currency_history\r\n    WHERE game = '$game'\r\n      AND league_id = (SELECT league_id FROM current_league)\r\n      AND fetched_at = (SELECT fetched_at FROM latest_snapshot)\r\n),\r\n\r\nbaseline AS (\r\n    SELECT currency_name, primary_value\r\n    FROM poe_currency_history\r\n    WHERE game = '$game'\r\n      AND league_id = (SELECT league_id FROM current_league)\r\n      AND fetched_at = (SELECT fetched_at FROM baseline_snapshot)\r\n),\r\n\r\nreference_values AS (\r\n    SELECT\r\n        MAX(primary_value) FILTER (WHERE currency_name = 'Divine Orb')  AS divine_value,\r\n        MAX(primary_value) FILTER (WHERE currency_name = 'Exalted Orb') AS exalted_value,\r\n        MAX(primary_value) FILTER (WHERE currency_name = 'Chaos Orb')   AS chaos_value\r\n    FROM snapshot\r\n),\r\n\r\nbaseline_reference AS (\r\n    SELECT MAX(primary_value) FILTER (WHERE currency_name = 'Divine Orb') AS divine_value\r\n    FROM baseline\r\n)\r\n\r\nSELECT\r\n    s.currency_name AS \"Currency\",\r\n\r\n    ROUND(s.primary_value / NULLIF(r.exalted_value, 0), 6) AS \"Exalted Orbs\",\r\n    ROUND(s.primary_value / NULLIF(r.chaos_value, 0), 6)   AS \"Chaos Orbs\",\r\n    ROUND(s.primary_value / NULLIF(r.divine_value, 0), 6)  AS \"Divines\",\r\n\r\n    CASE\r\n        WHEN (SELECT fetched_at FROM baseline_snapshot)\r\n             = (SELECT fetched_at FROM latest_snapshot) THEN NULL\r\n        ELSE ROUND(100 * (\r\n                 (s.primary_value * br.divine_value)\r\n                 / NULLIF(b.primary_value * r.divine_value, 0)\r\n                 - 1\r\n             ), 2)\r\n    END AS \"7d %\"\r\n\r\nFROM snapshot s\r\nCROSS JOIN reference_values r\r\nCROSS JOIN baseline_reference br\r\nLEFT JOIN baseline b ON b.currency_name = s.currency_name\r\n\r\nORDER BY s.primary_value DESC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
