          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "poe-postgres"
                      },
                      "spec": {
                        "dataset": "poe_tracker_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n    currency.fetched_at AS time,\r\n\r\n    currency.primary_value /\r\n        NULLIF(divine.primary_value, 0)\r\n        AS \"Divines\"\r\n\r\nFROM poe_currency_history currency\r\n\r\nJOIN poe_currency_history divine\r\n    ON divine.game = currency.game\r\n    AND divine.league_id = currency.league_id\r\n    AND divine.fetched_at = currency.fetched_at\r\n    AND divine.currency_name = 'Divine Orb'\r\n\r\nWHERE currency.game = '$game'\r\n  AND currency.league_id = '$league'\r\n  AND currency.currency_name = '$currency'\r\n  AND $__timeFilter(currency.fetched_at)\r\n\r\nORDER BY currency.fetched_at;",
