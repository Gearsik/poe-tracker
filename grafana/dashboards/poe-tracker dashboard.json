      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Mirror of Kalandra",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "poe-postgres"
                      },
                      "spec": {
                        "dataset": "poe_tracker_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH current_league AS (\r\n    SELECT league_id\r\n    FROM poe_currency_history\r\n    WHERE game = '$game'\r\n      AND league_id = '$league'\r\n    ORDER BY fetched_at DESC\r\n    LIMIT 1\r\n),\r\nlatest_snapshot AS (\r\n    SELECT MAX(fetched_at) AS fetched_at\r\n    FROM poe_currency_history\r\n    WHERE game = '$game'\r\n      AND league_id = (SELECT league_id FROM current_league)\r\n)\r\nSELECT\r\n    mirror.primary_value / NULLIF(divine.primary_value, 0) AS value\r\nFROM poe_currency_history mirror\r\nJOIN poe_currency_history divine\r\n    ON mirror.game = divine.game\r\n    AND mirror.league_id = divine.league_id\r\n    AND mirror.fetched_at = divine.fetched_at\r\nWHERE mirror.game = '$game'\r\n  AND mirror.league_id = (SELECT league_id FROM current_league)\r\n  AND mirror.fetched_at = (SELECT fetched_at FROM latest_snapshot)\r\n  AND mirror.currency_name = 'Mirror of Kalandra'\r\n  AND divine.currency_name = 'Divine Orb';",
                        "sql": {
